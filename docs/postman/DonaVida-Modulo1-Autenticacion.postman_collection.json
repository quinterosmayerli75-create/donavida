              "raw": "{\n  \"nombre\": \"Carla\",\n  \"apellidos\": \"Gutiérrez Soria\",\n  \"email\": \"carla@donavida.test\",\n  \"telefono\": \"71234567\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"ci\": \"8123456\",\n  \"fecha_nacimiento\": \"2002-05-10\",\n  \"sexo\": \"F\",\n  \"tipo_sangre_id\": 4,\n  \"peso_kg\": 58,\n  \"zona\": \"Queru Queru\",\n  \"latitud\": -17.3765,\n  \"longitud\": -66.1561\n}",
