                            ]
                        },
                        "description": "Donaciones (la más reciente primero), totales e insignia \"Héroe nivel X\".",
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{token}}",
